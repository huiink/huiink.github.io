---
import GiscusComments from "@components/GiscusComments.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { friends } from "@/data/friends";
---

<MainGridLayout title="友鏈" description="夥伴們">
	<section class="card-base px-6 md:px-9 py-6 mb-4">
		<div class="markdown-content">
			<h2 id="本站資訊">本站資訊</h2>
			<ul>
				<li>站名：Huiink's Blog</li>
				<li>站長：老祖</li>
				<li>網址：<code>https://huiink.github.io</code></li>
			</ul>
			<h2 id="申請方法">申請方法</h2>
			<p>加入本站後，在本頁留言，格式如下：</p>
			<pre><code>- name: 名字
  url: 網址
  desc: 描述
  image: 頭像網址</code></pre>
		</div>
	</section>

	<section class="mb-4">
		<h2 class="transition w-full block font-bold mb-4 text-2xl text-black/80 dark:text-white/80">
			夥伴們
		</h2>
		<div class="grid gap-4 sm:grid-cols-2">
			{friends.map((friend) => (
				<a
					class="card-base group flex items-center gap-4 p-4 active:scale-[0.98]"
					href={friend.url}
					target="_blank"
					rel="external nofollow noopener noreferrer"
					aria-label={friend.name}
				>
					<img
						class="h-16 w-16 rounded-2xl object-cover bg-black/5 dark:bg-white/10"
						src={friend.image}
						alt={friend.name}
						loading="lazy"
					/>
					<div class="min-w-0">
						<div class="font-bold text-lg text-black/80 dark:text-white/80 group-hover:text-[var(--primary)] transition">
							{friend.name}
						</div>
						<div class="mt-1 text-sm text-black/50 dark:text-white/50 line-clamp-2">
							{friend.desc}
						</div>
					</div>
				</a>
			))}
		</div>
	</section>

	<GiscusComments />
</MainGridLayout>
